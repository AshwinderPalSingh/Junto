# ─────────────────────────────────────────────────────────────
#  Junto configuration. `npm run setup` copies this to .env.local
#  and generates the secrets marked (generated).
# ─────────────────────────────────────────────────────────────

# Public URL of the app, used in emails and share links.
APP_URL=http://localhost:3000

# PostgreSQL connection string (required).
#   Local:  postgres://junto:password@localhost:5432/junto
#   Neon / Supabase / RDS: paste the connection string they give you
#   (append ?sslmode=require if your provider needs TLS).
DATABASE_URL=
# Connections per server instance.
DATABASE_POOL_MAX=10

# Legacy domain setting; campus access is fixed to thapar.edu. Moderator emails follow.
ALLOWED_EMAIL_DOMAINS=thapar.edu
ADMIN_EMAILS=

# ── Sign-in codes by email (required in production) ──────────
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender name and address; for Gmail it must be your Gmail address.
EMAIL_FROM=
# Alternatively, leave SMTP_* empty and use https://resend.com:
RESEND_API_KEY=

# ── Web Push notifications (generated) ───────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protects GET/POST /api/cron/maintenance for an external scheduler (generated).
CRON_SECRET=

# docker-compose only: password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
# University Google sign-in and profile names. Never use SMTP credentials here.
# Register https://YOUR_DOMAIN/auth/campus/callback as the exact redirect URI.
CAMPUS_IDENTITY_PROVIDER=google
CAMPUS_OIDC_CLIENT_ID=
CAMPUS_OIDC_CLIENT_SECRET=
# Microsoft only: university tenant UUID (not "common" or "organizations").
CAMPUS_MICROSOFT_TENANT_ID=
