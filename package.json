{
  "name": "junto",
  "version": "0.1.0",
  "private": true,
  "description": "Junto: an activity-first campus companion network (Next.js MVC + PostgreSQL).",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
