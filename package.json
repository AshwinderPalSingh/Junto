    "email:test": "node scripts/test-email.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
